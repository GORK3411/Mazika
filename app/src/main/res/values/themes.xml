<resources>

    <!-- Base (shared) -->
    <style name="Theme.Mazika.Base" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Text on primary -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- ✅ Use framework background attr (avoids missing colorBackground) -->
        <item name="android:colorBackground">@color/app_bg</item>

        <!-- Surfaces (Material) -->
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status/navigation bars -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/app_bg</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <!-- Accent themes -->
    <style name="Theme.Mazika.Accent.Purple" parent="Theme.Mazika.Base">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/accent_purple_variant</item>
    </style>

    <style name="Theme.Mazika.Accent.Green" parent="Theme.Mazika.Base">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_variant</item>
    </style>

    <style name="Theme.Mazika.Accent.Blue" parent="Theme.Mazika.Base">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_variant</item>
    </style>

    <style name="Theme.Mazika.Accent.Orange" parent="Theme.Mazika.Base">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange_variant</item>
    </style>

    <!-- Default theme used by Manifest -->
    <style name="Theme.Mazika" parent="Theme.Mazika.Accent.Purple" />

</resources>
